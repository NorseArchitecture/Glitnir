<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<!-- Pinned to 10.1.0: SK MongoDB connector 1.74.0-preview nuspec declares 10.1.0 for all TFMs;
		     pinned here so the graph never floats higher. Original FINDINGS §8b (Qdrant) proved that
		     floating to 10.6.0 causes TypeLoadException at query time — same risk applies here. -->
		<PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.1.0" />
		<PackageReference Include="MongoDB.Bson" Version="3.8.1" />
	</ItemGroup>

</Project>
